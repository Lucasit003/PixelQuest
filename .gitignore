# OS
.DS_Store

# Editor
.vscode/
.idea/
.claude/

# Node (not used yet, but here in case tooling is added later)
node_modules/
npm-debug.log*

# Logs / temp
*.log
/tmp/
scratchpad/
tools/_index/

# Working screenshots from layout/art passes. Useful while iterating, but they
# are full-resolution map captures running 0.2-3MB each — the harnesses that
# produce them are committed, the output is not. Leading slash matters: an
# unanchored `dev/` also swallowed src/dev/.
/dev/

# Large source art (keep the game-ready versions only)

# Raw reference sheets and superseded masters. Everything the game does NOT load
# at runtime lives in assets/_src/ and is ignored as a folder — this used to be a
# hand-maintained list of individual filenames that had to be extended every time
# a sheet was added, and a missed entry meant megabytes of source art in the repo.
assets/_src/

# (old note) Raw reference sheets (already sliced into assets/props/ via tools/). Kept on
# disk so the cuts can be re-made, but never committed — the game only ever
# loads the sliced/baked versions, and these run 150KB-2MB each.

# Pre-edit backups of the plaza tiles
assets/plaza/_orig_mix/
assets/plaza/_pre_seam/
assets/plaza/_pre_tone/

# Secrets — never commit API keys
.env
.env.*
!.env.example
